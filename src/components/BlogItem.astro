---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

export interface Props {
	post: CollectionEntry<"blog">;
	compact?: boolean;
}

const { post, compact = false } = Astro.props;
---

<li class:list={["post-row", { compact }]}>
	{!compact && <FormattedDate date={post.data.pubDate} />}
	<a class="post-card" href={`/blog/${post.id}/`}>
		<span class="post-copy">
			<strong>
				{post.data.title}
				{post.data.external && <span class="external-marker" aria-label="Originally published elsewhere">↗</span>}
			</strong>
			<span>{post.data.description}</span>
		</span>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M5 12h14M13 6l6 6-6 6"></path>
		</svg>
	</a>
</li>

<style>
	.post-row {
		display: grid;
		grid-template-columns: 7.3rem minmax(0, 1fr);
		gap: 0.75rem;
		align-items: center;
	}
	.post-row :global(time) {
		color: var(--text-muted);
		font-size: 0.82rem;
	}
	.post-card {
		display: flex;
		min-width: 0;
		padding: 0.8rem 0.9rem;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border: 1px solid var(--border);
		border-radius: 0.55rem;
		font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
		text-decoration: none;
		transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
	}
	.post-card:hover {
		border-color: var(--border-strong);
		background: var(--surface-hover);
	}
	.post-copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
	}
	.post-copy strong,
	.post-copy > span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.post-copy > span {
		color: var(--text-muted);
		font-size: 0.83rem;
	}
	.external-marker {
		margin-left: 0.35rem;
		color: var(--text-muted);
		font-size: 0.8em;
	}
	svg {
		width: 1.15rem;
		height: 1.15rem;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
		transition: transform 180ms ease;
	}
	.post-card:hover svg {
		transform: translateX(0.18rem);
	}
	.post-row.compact {
		grid-template-columns: minmax(0, 1fr);
	}
	@media (max-width: 560px) {
		.post-row {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}
</style>
