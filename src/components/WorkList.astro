---
import { getCollection, render } from "astro:content";

export interface Props {
	homepage?: boolean;
}

const { homepage = false } = Astro.props;

const entries = (await getCollection("work"))
	.filter((entry) => !homepage || entry.data.homepage)
	.sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf());

const work = await Promise.all(
	entries.map(async (entry) => ({
		...entry,
		Content: (await render(entry)).Content,
	})),
);

const monthYear = new Intl.DateTimeFormat("en-US", {
	month: "short",
	year: "numeric",
	timeZone: "UTC",
});

const dateRange = (start: Date, end?: Date) =>
	`${monthYear.format(start)} — ${end ? monthYear.format(end) : "Present"}`;
---

<section class:list={["work-list", { "home-work": homepage }]}>
	<div class="section-header">
		{homepage ? <h2>Work experience</h2> : <h1>Work</h1>}
		{homepage && <a href="/work/">See all work</a>}
	</div>
	<ul>
		{work.map((entry) => (
			<li>
				<div class="dates">{dateRange(entry.data.dateStart, entry.data.dateEnd)}</div>
				<div class="company">{entry.data.company}</div>
				<div class="role">{entry.data.role} · {entry.data.location}</div>
				<div class="summary"><entry.Content /></div>
			</li>
		))}
	</ul>
</section>

<style>
	.work-list {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
	}
	.home-work {
		gap: 1.5rem;
	}
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	h1,
	h2 {
		margin: 0;
		font-weight: 600;
	}
	.section-header a {
		font-size: 0.875rem;
	}
	ul {
		display: flex;
		margin: 0;
		padding: 0;
		flex-direction: column;
		gap: 2rem;
		list-style: none;
	}
	li {
		min-width: 0;
	}
	.dates,
	.role {
		color: var(--text-muted);
		font-size: 0.875rem;
	}
	.company {
		color: var(--text-strong);
		font-weight: 500;
	}
	.role {
		font-weight: 400;
	}
	.summary :global(p) {
		margin: 0.45rem 0 0;
		color: var(--text);
	}
</style>
